<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SOMA – Gestión Documental Industrial</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.44.0/tabler-icons.min.css">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{font-family:'Inter',sans-serif;color:#1a1a1a;background:#fff;overflow-x:hidden;}

.reveal,.reveal-left,.reveal-right,.reveal-scale{
  opacity:0;
  transition:opacity 0.7s cubic-bezier(.22,.68,0,1.1),transform 0.7s cubic-bezier(.22,.68,0,1.1);
}
.reveal{transform:translateY(30px);}
.reveal-left{transform:translateX(-36px);}
.reveal-right{transform:translateX(36px);}
.reveal-scale{transform:scale(0.91);}
.reveal.visible,.reveal-left.visible,.reveal-right.visible,.reveal-scale.visible{opacity:1;transform:none;}
.d1{transition-delay:.05s!important;}
.d2{transition-delay:.13s!important;}
.d3{transition-delay:.21s!important;}
.d4{transition-delay:.29s!important;}
.d5{transition-delay:.37s!important;}
.d6{transition-delay:.45s!important;}

.draw-line{
  display:block;height:2px;
  background:linear-gradient(90deg,#C9A84C,#D8C3A5);
  width:0;border-radius:2px;margin-top:6px;
  transition:width 0.8s cubic-bezier(.22,.68,0,1.1);
}
.draw-line.visible{width:100%;}

/* NAV */
.nav{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 48px;border-bottom:1px solid #f0ede8;
  position:sticky;top:0;
  background:rgba(255,255,255,0.96);backdrop-filter:blur(12px);z-index:100;
  animation:navIn 0.5s ease both;
}
@keyframes navIn{from{opacity:0;transform:translateY(-14px)}to{opacity:1;transform:translateY(0)}}
.nav-logo img{height:72px;width:auto;display:block;}

/* HERO */
.hero-wrapper{position:relative;overflow:hidden;}
.hero-wrapper::before{
  content:'';position:absolute;inset:0;
  background-image:url('data:image/jpeg;base64,');
  background-size:cover;background-position:center 40%;
  opacity:1;z-index:0;
}
.hero-wrapper::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(to right,
    rgba(255,255,255,0.92) 0%,
    rgba(255,255,255,0.82) 38%,
    rgba(255,255,255,0.45) 62%,
    rgba(255,255,255,0.15) 100%);
  z-index:0;
}
.hero-wrapper .section.hero{position:relative;z-index:1;}

.hero{
  display:grid;grid-template-columns:1fr 1fr;gap:48px;
  padding:70px 48px 90px;max-width:1120px;margin:0 auto;align-items:center;
}
.hero-tag{
  display:inline-flex;align-items:center;gap:7px;
  background:#f0ede8;color:#5a4f42;font-size:12px;font-weight:500;
  padding:5px 14px;border-radius:100px;margin-bottom:26px;letter-spacing:0.3px;
  animation:fadeUp 0.6s 0.2s ease both;
}
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.hero-tag-dot{width:6px;height:6px;background:#C9A84C;border-radius:50%;}
.hero h1{
  font-size:42px;font-weight:700;line-height:1.12;letter-spacing:-1.2px;
  color:#111;margin-bottom:22px;min-height:110px;
}
.hero h1 em{font-style:normal;color:#183B2D;}
.hero-sub{
  font-size:16px;line-height:1.7;color:#4a4038;margin-bottom:38px;max-width:440px;
  animation:fadeUp 0.6s 0.75s ease both;
}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap;animation:fadeUp 0.6s 0.95s ease both;}
.btn-primary{
  background:#183B2D;color:#D8C3A5;border:none;
  padding:14px 28px;border-radius:10px;font-size:14.5px;font-weight:600;
  cursor:pointer;font-family:'Inter',sans-serif;text-decoration:none;
  transition:all 0.15s;display:inline-flex;align-items:center;gap:8px;
}
.btn-primary:hover{background:#1F4A38;transform:translateY(-1px);}

/* NUESTRO ENFOQUE PANEL (hero right) */
.enfoque-panel{
  background:#ffffff;border:1px solid #ede9e3;border-radius:20px;padding:36px;
  animation:fadeUp 0.7s 0.4s ease both;
  box-shadow:0 18px 50px rgba(24,59,45,0.10);
}
.enfoque-logo{margin-bottom:20px;}
.enfoque-logo img{height:50px;width:auto;}
.enfoque-divider{width:100%;height:1px;background:#e8e2d8;margin-bottom:24px;}
.enfoque-label{
  display:inline-flex;align-items:center;gap:6px;
  font-size:10px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;
  color:#C9A84C;margin-bottom:14px;
}
.enfoque-label-dot{width:5px;height:5px;background:#C9A84C;border-radius:50%;}
.enfoque-title{
  font-size:19px;font-weight:700;color:#183B2D;line-height:1.32;
  letter-spacing:-0.3px;margin-bottom:24px;
}
.sol-pills{display:flex;flex-direction:column;gap:10px;}
.sol-pill{
  display:flex;align-items:center;gap:10px;
  background:#f9f7f4;border:1px solid #ede9e3;
  border-radius:10px;padding:12px 16px;
  transition:background 0.2s,transform 0.2s;
}
.sol-pill:hover{background:#f0ede4;transform:translateX(4px);}
.sol-pill i{color:#C9A84C;font-size:15px;}
.sol-pill span{font-size:13px;color:#3a342c;font-weight:500;}

/* SECTION SHARED */
.section{padding:80px 48px;max-width:1120px;margin:0 auto;}
.section-eyebrow{font-size:11px;font-weight:600;color:#C9A84C;letter-spacing:1.4px;text-transform:uppercase;margin-bottom:12px;}
.section-title{font-size:32px;font-weight:700;letter-spacing:-0.8px;line-height:1.2;color:#111;margin-bottom:10px;max-width:640px;}
.section-lead{font-size:15px;color:#7a6e64;line-height:1.65;max-width:540px;margin-bottom:44px;}

/* DEVELOPMENT SECTION */
.dev-section{background:#fff;border-top:1px solid #f0ede8;}
.dev-inner{display:grid;grid-template-columns:5fr 4fr;gap:64px;align-items:start;}
.dev-body{font-size:15px;line-height:1.8;color:#4a4038;margin-bottom:28px;}
.dev-body p{margin-bottom:18px;}
.dev-body strong{color:#183B2D;font-weight:600;}
.dev-highlight{
  background:#f9f7f4;border-left:3px solid #C9A84C;
  border-radius:0 12px 12px 0;padding:20px 24px;
  font-size:15px;line-height:1.7;color:#183B2D;font-weight:600;
  margin-bottom:28px;
}
.platforms-label{font-size:11px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;color:#9a8d80;margin-bottom:14px;}
.platforms{display:flex;flex-wrap:wrap;gap:8px;}
.platform-pill{
  background:#f0ede8;border:1px solid #e0d8cc;
  border-radius:8px;padding:7px 14px;
  font-size:12px;font-weight:600;color:#183B2D;
  transition:all 0.15s;
}
.platform-pill:hover{background:#183B2D;color:#D8C3A5;}

/* MISIÓN/VISIÓN PANEL (dev right) */
.mv-card{
  background:#183B2D;border:none;border-radius:20px;padding:32px;
  position:sticky;top:100px;
  box-shadow:0 18px 50px rgba(24,59,45,0.18);
}
.mv-card .label{font-size:10px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:#C9A84C;margin-bottom:14px;}
.mv-card h3{font-size:19px;font-weight:700;color:#fff;line-height:1.3;letter-spacing:-0.3px;margin-bottom:24px;}
.mv-block-label{font-size:10px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#D8C3A5;margin-bottom:8px;}
.mv-block-text{font-size:12.5px;line-height:1.7;color:rgba(255,255,255,0.82);}
.mv-sep{height:1px;background:rgba(216,195,165,0.22);margin:20px 0;}
.mv-pill-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px;}
.mv-pill{
  background:rgba(216,195,165,0.12);border:1px solid rgba(216,195,165,0.25);border-radius:100px;
  padding:6px 14px;font-size:11px;font-weight:600;color:#D8C3A5;
}

/* PROBLEMA */
.prob-section{background:#f9f7f4;border-top:1px solid #ede9e3;border-bottom:1px solid #ede9e3;}
.prob-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:36px;}
.prob-card{
  background:#fff;border-radius:16px;border:1px solid #ede9e3;padding:28px 22px;
  transition:transform 0.2s,box-shadow 0.2s;
}
.prob-card:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(0,0,0,0.07);}
.prob-icon{
  width:44px;height:44px;background:#fff0ee;border-radius:12px;
  display:flex;align-items:center;justify-content:center;font-size:20px;
  margin-bottom:16px;border:1px solid #f5ddd8;
}
.prob-card h3{font-size:14px;font-weight:700;color:#1a1a1a;margin-bottom:8px;line-height:1.3;}
.prob-card p{font-size:12px;color:#9a8d80;line-height:1.6;}
.prob-footer{
  text-align:center;font-size:15px;font-weight:500;color:#4a3f35;
  padding:24px 32px;background:#fff;border-radius:14px;border:1px solid #ede9e3;
  max-width:600px;margin:0 auto;line-height:1.6;
}
.prob-footer strong{color:#183B2D;}

/* SOLUCIÓN */
.sol-inner{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;}
.flow{display:flex;flex-direction:column;}
.flow-item{display:flex;align-items:flex-start;gap:16px;}
.flow-left{display:flex;flex-direction:column;align-items:center;flex-shrink:0;}
.flow-dot{
  width:36px;height:36px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:12px;font-weight:700;z-index:1;
  transition:transform 0.25s,box-shadow 0.25s;
}
.flow-dot:hover{transform:scale(1.12);box-shadow:0 4px 16px rgba(24,59,45,0.2);}
.flow-dot.normal{background:#f0ede8;color:#5a4f42;border:1.5px solid #ddd8d0;}
.flow-dot.soma{background:#183B2D;color:#D8C3A5;border:2px solid #183B2D;font-size:11px;}
.flow-dot.result{background:#eaf4ea;color:#1a6b1a;border:1.5px solid #c0ddc0;}
.flow-line{width:2px;height:28px;background:#e5e0d8;}
.flow-content{padding-top:6px;padding-bottom:26px;}
.flow-content h4{font-size:14px;font-weight:600;color:#1a1a1a;margin-bottom:3px;}
.flow-content p{font-size:12px;color:#9a8d80;line-height:1.55;}
.flow-item:last-child .flow-content{padding-bottom:0;}
.sol-right{background:#183B2D;border-radius:20px;padding:36px;}
.sol-right-label{font-size:10px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#D8C3A5;margin-bottom:18px;}
.sol-right h3{font-size:21px;font-weight:700;line-height:1.3;letter-spacing:-0.3px;margin-bottom:22px;color:#fff;}

/* RESULTADO */
.res-section{background:#f9f7f4;border-top:1px solid #ede9e3;border-bottom:1px solid #ede9e3;}
.res-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:40px;}
.res-card{
  background:#fff;border-radius:16px;border:1px solid #ede9e3;
  padding:26px 22px;display:flex;gap:14px;align-items:flex-start;
  transition:transform 0.2s,box-shadow 0.2s;
}
.res-card:hover{transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,0,0,0.06);}
.res-check{
  width:28px;height:28px;background:#eaf4ea;border-radius:8px;
  display:flex;align-items:center;justify-content:center;
  color:#2a7a2a;font-size:14px;flex-shrink:0;margin-top:1px;
}
.res-card h3{font-size:14px;font-weight:700;color:#183B2D;margin-bottom:5px;}
.res-card p{font-size:12px;color:#9a8d80;line-height:1.55;}
.res-banner{background:#183B2D;border-radius:16px;padding:32px 40px;text-align:center;}
.res-banner p{font-size:20px;font-weight:600;color:#fff;letter-spacing:-0.3px;line-height:1.4;}
.res-banner span{color:#D8C3A5;font-style:italic;}

/* CTA */
.cta-section{background:#183B2D;padding:90px 48px;text-align:center;position:relative;overflow:hidden;}
.cta-bg{position:absolute;border-radius:50%;background:rgba(216,195,165,0.05);pointer-events:none;}
.cta-eyebrow{font-size:11px;font-weight:600;color:#C9A84C;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:18px;}
.cta-title{font-size:34px;font-weight:700;color:#fff;letter-spacing:-0.8px;line-height:1.2;max-width:640px;margin:0 auto 16px;}
.cta-sub{font-size:15px;color:rgba(216,195,165,0.8);margin-bottom:40px;line-height:1.65;}
.cta-btn{
  background:#D8C3A5;color:#183B2D;border:none;
  padding:16px 38px;border-radius:12px;font-size:16px;font-weight:700;
  cursor:pointer;font-family:'Inter',sans-serif;text-decoration:none;
  transition:all 0.15s;display:inline-flex;align-items:center;gap:9px;margin-bottom:44px;
}
.cta-btn:hover{background:#e8d4b5;transform:translateY(-2px);}
.cta-divider{display:flex;align-items:center;gap:16px;max-width:300px;margin:0 auto 28px;}
.cta-divider hr{flex:1;border:none;border-top:1px solid rgba(216,195,165,0.2);}
.cta-divider span{font-size:12px;color:rgba(216,195,165,0.45);}
.cta-contacts{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;}
.cta-contact{
  display:flex;align-items:center;gap:8px;
  background:rgba(216,195,165,0.1);border:1px solid rgba(216,195,165,0.2);
  border-radius:100px;padding:9px 18px;
  color:rgba(255,255,255,0.85);font-size:13px;font-weight:500;text-decoration:none;
  transition:background 0.2s,transform 0.15s;
}
.cta-contact:hover{background:rgba(216,195,165,0.2);transform:translateY(-2px);}
.cta-contact i{color:#C9A84C;}

/* FOOTER */
.footer{background:#0f2a1f;padding:24px 48px;display:flex;align-items:center;justify-content:space-between;}
.footer img{height:38px;width:auto;}
.footer-right{font-size:11px;color:rgba(216,195,165,0.4);}

@media (max-width: 900px) {
  .hero, .sol-inner, .dev-inner { grid-template-columns: 1fr; }
  .prob-cards, .res-grid { grid-template-columns: 1fr 1fr; }
}
</style>
</head>
