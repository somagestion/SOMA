<script>
(function(){
  const lines = ["Documentación lista,", "operación en marcha."];
  const el = document.getElementById('hero-headline');
  let li=0, ci=0;
  function type(){
    if(li>=lines.length) return;
    const line=lines[li];
    const isSecond = li===1;
    let display='';
    for(let x=0;x<li;x++){
      if(x===1) display+='<em>'+lines[x]+'</em><br>';
      else display+=lines[x]+'<br>';
    }
    if(isSecond) display+='<em>'+line.slice(0,ci+1)+'</em>';
    else display+=line.slice(0,ci+1);
    el.innerHTML=display;
    ci++;
    if(ci>=line.length){ ci=0; li++; setTimeout(type,li<lines.length?200:0); }
    else setTimeout(type, isSecond?55:38);
  }
  setTimeout(type,700);
})();

(function(){
  const all=document.querySelectorAll('.reveal,.reveal-left,.reveal-right,.reveal-scale,.draw-line');
  const obs=new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target);}
    });
  },{threshold:0.1,rootMargin:'0px 0px -30px 0px'});
  all.forEach(t=>{
    obs.observe(t);
    const r=t.getBoundingClientRect();
    if(r.top<window.innerHeight&&r.bottom>0) setTimeout(()=>t.classList.add('visible'),80);
  });
})();

(function(){
  const panel=document.querySelector('.enfoque-panel');
  if(!panel) return;
  window.addEventListener('scroll',()=>{
    panel.style.transform='translateY('+(-window.scrollY*0.03)+'px)';
  },{passive:true});
})();
</script>
